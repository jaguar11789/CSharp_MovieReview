{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=MovieReviewDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY",
    "Issuer": "MovieReviewApi",
    "Audience": "MovieReviewClient",
    "ExpiresMinutes": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Kakao": {
    "RestApiKey": "YOUR_KAKAO_REST_API_KEY",
    "ClientSecret": "YOUR_KAKAO_CLIENT_SECRET",
