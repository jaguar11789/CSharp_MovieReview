  },

  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "https://localhost:7226/api/Auth/google/callback"
  },

  "TMDB": {
    "ApiKey": "YOUR_TMDB_API_KEY"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
